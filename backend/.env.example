# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Supported dialects: 'mysql' or 'sqlite'
# When set to 'mysql', ensure MySQL server is running.
# When set to 'sqlite' or if MySQL connection fails, it auto-initializes the embedded database.
DB_DIALECT=sqlite

# MySQL Connection Details (if using DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_booking_db

